# =========================================================================
# Next.js frontend env — copy to .env.local and fill in real values.
# =========================================================================
#
# After this refactor the FRONTEND no longer talks to Supabase directly:
# all reads/writes go through the FastAPI backend in /api. The only env
# var the frontend needs is the URL of that backend.
#
# The Supabase URL/anon key entries are kept commented out in case you
# want to run a quick experiment hitting Supabase directly from the
# browser. Production code paths don't read them anymore.
# =========================================================================

# URL of the FastAPI backend (see /api). In dev that's localhost:8000;
# in production it's whatever URL you deploy the API to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional: GitHub metadata on /projects/[slug] ---
#
# The project detail page pulls real repo data (stars, forks, languages,
# file listing, commit activity) from GitHub's public API. That works with
# NO token — you can leave this unset and the page is complete.
#
# What a token buys:
#   • The "last commit message" and "time" columns in the file list. Those
#     cost one API request per file, which doesn't fit in the 60 requests/hr
#     that unauthenticated callers get, so they're switched off without one.
#   • Headroom: 5,000 requests/hr instead of 60.
#
# Use a fine-grained personal access token with PUBLIC REPO READ ONLY and no
# write scopes — this only ever reads public metadata, so anything more is
# unnecessary risk.
#
# NOTE the missing NEXT_PUBLIC_ prefix. That is not an oversight: any var
# with that prefix is inlined into the JavaScript bundle and shipped to every
# visitor's browser. This one is read only in Server Components, so it stays
# on the server. Never add the prefix to a token.
# GITHUB_TOKEN=github_pat_...

# --- Optional / legacy ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
